# Your domain WITHOUT https:// (A record must point to the VPS), e.g. app.yourdomain.com
DOMAIN=

# Copy to .env on the server and fill in. Never commit .env.
NODE_ENV=production
PORT=3000

# From Shopify Partner Dashboard > your app > Client credentials
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_customers,read_products,write_products,write_files
# Your public HTTPS URL, no trailing slash, e.g. https://app.yourdomain.com
# Docker sets SHOPIFY_APP_URL from DOMAIN automatically (only needed without Docker)
SHOPIFY_APP_URL=

# Database (SQLite). Optional: when empty the app creates ./storage/shoppilot.sqlite itself (Docker uses /data).
# DATABASE_URL=file:/absolute/path/shoppilot.sqlite

# Recommended on Hostinger: ONE folder outside the app folder for the database, WhatsApp login and photos,
# so a redeploy never wipes them. Example: DATA_DIR=/home/YOUR_USER/shoppilot-data
# DATA_DIR=

# Encrypts API keys saved in the app (generate: openssl rand -hex 32). Do not change after first use.
SECRETS_KEY=

# WhatsApp: Docker stores its login/media in the /data volume automatically.
# Only for WhatsApp Cloud API mode:
# WHATSAPP_PROVIDER=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Optional
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOP_CUSTOM_DOMAIN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# IMS_API_KEY=
# IMS_LOOKUP_KEY=
